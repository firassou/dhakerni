# Speech-to-text (default) and parser
ELEVENLABS_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Which providers to use (see docs/decisions.md D5)
STT_PROVIDER=elevenlabs  # elevenlabs (default) | groq | gemini
PARSE_PROVIDER=google    # google (default) | groq
# STT_MODEL= PARSE_MODEL= STT_LANGUAGE=

# Reminder store (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push. Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# 32 random bytes, base64: openssl rand -base64 32
REMINDER_ENCRYPTION_KEY=
# Protects /api/cron/fire: openssl rand -hex 24
CRON_SECRET=

# Optional: exact-time reminders. From the Upstash console, QStash tab. See README, "Scheduler".
QSTASH_TOKEN=
QSTASH_URL=
